# Sao chép thành backend/.env rồi sửa cho đúng MySQL, RabbitMQ trên máy (README, mục 6).
# Ghi giá trị trực tiếp, không bọc trong dấu nháy.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cinema_db
DB_USERNAME=root
DB_PASSWORD=change-me

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Cấu hình JWT, bảo mật, CORS và Google OAuth2 (tùy chọn khi chạy dev, có giá trị mặc định trong application.yml)
JWT_SECRET=cinema-dev-secret-key-please-change-in-production-at-least-256-bits
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000
SECURITY_LOCK_DURATION_MINUTES=15
CORS_ALLOWED_ORIGINS=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback

# Firebase Phone OTP
FIREBASE_PROJECT_ID=replace_with_firebase_project_id
# Set GOOGLE_APPLICATION_CREDENTIALS outside this repository for production.
