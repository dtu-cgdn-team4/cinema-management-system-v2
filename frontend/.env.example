# URL gốc của backend
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Cấu hình Firebase Web App (giá trị mẫu, không điền credential thật vào đây)
VITE_FIREBASE_API_KEY=AIzaSyExampleKeyPlaceholder
VITE_FIREBASE_AUTH_DOMAIN=demo-cinema.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-cinema
VITE_FIREBASE_STORAGE_BUCKET=demo-cinema.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Firebase Auth Emulator Host (dành cho kiểm thử local với backend/firebase.json cổng 9099)
# VITE_FIREBASE_AUTH_EMULATOR_HOST=http://127.0.0.1:9099
